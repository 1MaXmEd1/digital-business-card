generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  github      String
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
}

model Skill {
  id        Int        @id @default(autoincrement())
  name      String
  level     SkillLevel
  profileId Int
  profile   Profile    @relation(fields: [profileId], references: [id])
}


model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  profileId    Int
  profile      Profile   @relation(fields: [profileId], references: [id])
}

model Project {
  id        Int     @id @default(autoincrement())
  name      String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id])
}
